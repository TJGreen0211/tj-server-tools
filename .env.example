# Host ports (bound on 0.0.0.0)
SPEECH_PORT=5003
TTS_PORT=5004

# GPU to use. Find it with: ls -l /dev/dri/by-path/   (7900 XTX = pci-0000:13:00.0 -> renderD130)
RENDER_NODE=renderD130

# Host group IDs: getent group video render
VIDEO_GID=44
RENDER_GID=992

# Speech tuning (defaults shown; see README > Meeting sessions)
# MEETING_WINDOW_SEC=480
# SAME_SPEAKER_SIMILARITY=0.5
# SILENCE_RMS=0.005
