# Host ports (bound on 0.0.0.0)
SPEECH_PORT=5003
TTS_PORT=5004

# NVIDIA GPU both services share (see nvidia-smi for indices)
NVIDIA_DEVICE_ID=0

# Speech tuning (defaults shown; see README > Meeting sessions)
# MEETING_WINDOW_SEC=480
# SAME_SPEAKER_SIMILARITY=0.5
# SILENCE_RMS=0.005
# STT_WARM_SEC=60

# Text to speech tuning (defaults shown; see README > Text to speech)
# TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base     # or Qwen/Qwen3-TTS-12Hz-1.7B-Base (better, slower)
# TTS_DTYPE=auto                              # auto: bfloat16 on Ampere+, float16 on Turing (RTX 20xx); float32 if fp16 sounds wrong
# TTS_DEFAULT_VOICE=default
# TTS_CLONE_MODE=auto                         # auto: closest clone when the voice has a transcript; xvec: embedding only
# TTS_STREAM_CHUNK=8                          # codec steps per streamed chunk (12 = 1 s); lower = earlier first audio
# TTS_MAX_INPUT_CHARS=4000                    # longer requests are rejected (400)
# TTS_MAX_GEN_SEC=300                         # a generation stops here, whatever the client does
# TTS_WAIT_SEC=60                             # longest a request waits for the GPU before a 503
# TTS_MAX_WAITING=8                           # requests already waiting beyond this get a 503 at once
